<Window x:Class="AromaDom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AromaDom"
        mc:Ignorable="d"
        Title="Материалы" Height="450" Width="800">
    <Grid>
        <DataGrid x:Name="MaterialsDataGrid"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding name}"/>
                <DataGridTextColumn Header="Тип материала" Binding="{Binding material_type_id}"/>
                <DataGridTextColumn Header="Единица" Binding="{Binding unit_id}"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding price}"/>
                <DataGridTextColumn Header="Количество на складе" Binding="{Binding stock_qty}"/>
                <DataGridTextColumn Header="Минимальное количество" Binding="{Binding min_qty}"/>
                <DataGridTextColumn Header="Количество в упаковке" Binding="{Binding pack_qty}"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Margin="10">
            <DataGrid x:Name="MaterialsDataGrid2" AutoGenerateColumns="True" IsReadOnly="True" Height="300"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Рассчитать" Width="120" Click="CalculateButton_Click"/>
                <TextBlock x:Name="ResultTextBlock" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <Button Content="Добавить" Width="120" Click="AddButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
