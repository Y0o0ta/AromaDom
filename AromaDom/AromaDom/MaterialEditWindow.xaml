<Window x:Class="AromaDom.MaterialEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AromaDom"
        mc:Ignorable="d"
        Title="Редактирование материала" Height="450" Width="800">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Тип материала:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <ComboBox x:Name="TypeComboBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10"/>
        
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Наименование:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox x:Name="NameTextBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10"/>
        
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Цена единицы:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox x:Name="PriceTextBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Единица измерения:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox x:Name="UnitTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Количество в упаковке:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox x:Name="PackageQtyTextBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Количество на складе:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox x:Name="StockQtyTextBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Минимальное количество:" VerticalAlignment="Center" Margin="0,0,10,10"/>
        <TextBox x:Name="MinQtyTextBox" Grid.Row="6" Grid.Column="1" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить" Width="100" Height="30" Margin="0,0,10,0" Click="SaveButton_Click"/>
            <Button Content="Отмена" Width="100" Height="30" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
